  39: public class ButtonDiffblueTest {
  40:   /**
  41:    * Test {@link Button#Button(Element, FormatEnum)}.
  42:    *
  43:    * <ul>
  44:    *   <li>When {@link BulletList#BulletList(Element)} with parent is {@link Element}.
  45:    *   <li>Then {@link Button#logger} return {@link Logger}.
  46:    * </ul>
  47:    *
  48:    * <p>Method under test: {@link Button#Button(Element, FormatEnum)}
  49:    */
  50:   @Test
  51:   @Category(ContributionFromDiffblue.class)
  52:   @ManagedByDiffblue
  53:   @MethodsUnderTest({"void Button.<init>(Element, FormatEnum)"})
  54:   public void testNewButton_whenBulletListWithParentIsElement_thenLoggerReturnLogger() {
  55:     // Arrange
  56:     BulletList parent = new BulletList(mock(Element.class));
  57:     Bold parent2 = new Bold(parent);
  58: 
  59:     // Act
  60:     Button actualButton = new Button(parent2, FormatEnum.MESSAGEML);
  61: 
  62:     // Assert
  63:     assertTrue(actualButton.logger instanceof Logger);
  64:     Element parent3 = actualButton.getParent();
  65:     assertTrue(parent3 instanceof Bold);
  66:     assertEquals(0, actualButton.size());
  67:     Map<String, String> attributes = actualButton.getAttributes();
  68:     assertEquals(1, attributes.size());
  69:     assertEquals(FormatEnum.MESSAGEML, actualButton.getFormat());
  70:     assertTrue(actualButton.getChildren().isEmpty());
  71:     assertTrue(attributes.containsKey(Entity.TYPE_FIELD));
  72:     assertEquals(Button.MESSAGEML_TAG, actualButton.getMessageMLTag());
  73:     assertEquals(Button.MESSAGEML_TAG, actualButton.getPresentationMLTag());
  74:     assertSame(parent2, parent3);
  75:   }
