 710:    * <p>Method under test: {@link Button#updateBiContext(BiContext)}
 711:    */
 712:   @Test
 713:   @Category(ContributionFromDiffblue.class)
 714:   @ManagedByDiffblue
 715:   @MethodsUnderTest({"void Button.updateBiContext(BiContext)"})
 716:   public void testUpdateBiContext_thenButtonWithParentIsBoldAndFormatIsMessagemlLoggerLogger() {
 717:     // Arrange
 718:     BulletList parent = new BulletList(mock(Element.class));
 719:     Bold parent2 = new Bold(parent);
 720:     Button button = new Button(parent2, FormatEnum.MESSAGEML);
 721:     BiContext context = new BiContext();
 722: 
 723:     // Act
 724:     button.updateBiContext(context);
 725: 
 726:     // Assert
 727:     org.slf4j.Logger logger = button.logger;
 728:     assertTrue(logger instanceof Logger);
 729:     LoggerContext loggerContext = ((Logger) logger).getLoggerContext();
 730:     StatusManager statusManager = loggerContext.getStatusManager();
 731:     List<Status> copyOfStatusList = statusManager.getCopyOfStatusList();
 732:     assertEquals(6, copyOfStatusList.size());
 733:     Status getResult = copyOfStatusList.get(5);
 734:     Object origin = getResult.getOrigin();
 735:     assertTrue(origin instanceof JoranConfigurator);
 736:     assertTrue(statusManager instanceof BasicStatusManager);
 737:     assertTrue(getResult instanceof InfoStatus);
 738:     List<BiItem> items = context.getItems();
 739:     assertEquals(1, items.size());
 740:     BiItem getResult2 = items.get(0);
 741:     Map<String, Object> attributes = getResult2.getAttributes();
 742:     assertEquals(1, attributes.size());
 743:     Map<String, String> attributes2 = button.getAttributes();
 744:     assertEquals(1, attributes2.size());
 745:     assertTrue(attributes2.containsKey(Entity.TYPE_FIELD));
 746:     assertTrue(((JoranConfigurator) origin).getInterpretationContext().getObjectStack().isEmpty());
 747:     assertTrue(loggerContext.getTurboFilterList().isEmpty());
 748:     assertEquals(Button.ACTION_TYPE, attributes.get(Entity.TYPE_FIELD));
 749:     assertEquals(Button.MESSAGEML_TAG, getResult2.getName());
 750:   }
 751: }
